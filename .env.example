# Copy to .env and replace every "change-me" value. Never commit .env.
# Generate a value: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
APP_BASE_URL=http://localhost:8000

# mock = built-in pretend eGRAS (no credentials needed)
# egras = real adapter in app/gateways/egras.py (complete it first, see docs/EGRAS_INTEGRATION.md)
GATEWAY_MODE=mock

API_KEY=change-me-to-a-long-random-api-key-value
MOCK_CALLBACK_SECRET=change-me-to-a-different-long-random-secret

# Issued to your department by the state treasury / eGRAS team. Leave empty for mock mode.
EGRAS_PAYMENT_URL=
EGRAS_VERIFICATION_URL=
EGRAS_MERCHANT_CODE=
EGRAS_SECRET_KEY=
